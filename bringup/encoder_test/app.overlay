/* NUCLEO-F401RE, encoder-only hand-turn test. No actuator outputs. */
#include <zephyr/dt-bindings/gpio/gpio.h>

/ {
    encoder_inputs {
        compatible = "gpio-keys";
        left_a: left_a { gpios = <&gpiob 3 GPIO_PULL_UP>; };
        left_b: left_b { gpios = <&gpioa 8 GPIO_PULL_UP>; };
        right_a: right_a { gpios = <&gpiob 5 GPIO_PULL_UP>; };
        right_b: right_b { gpios = <&gpioa 7 GPIO_PULL_UP>; };
    };
};

/* Keep only USART2 (ST-LINK USB serial console) active. In particular,
 * default I2C3 uses PA8 and default SPI1 uses PA7, both encoder inputs. */
&usart1 { status = "disabled"; };
&i2c1 { status = "disabled"; };
&i2c3 { status = "disabled"; };
&spi1 { status = "disabled"; };
&spi2 { status = "disabled"; };
&timers2 { status = "disabled"; };
&adc1 { status = "disabled"; };
