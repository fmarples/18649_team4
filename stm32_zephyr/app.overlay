/*
 * BOARD-SPECIFIC FILE -- YOU MUST EDIT THIS.
 *
 * The alias below must point to the physical UART peripheral connected to
 * the Raspberry Pi.
 *
 * Example only:
 *
 * / {
 *     aliases {
 *         app-uart = &usart2;
 *     };
 * };
 *
 * The actual UART node name and pinctrl settings depend on your exact
 * Nucleo/STM32 board.
 *
 * Also configure:
 *   - TX pin
 *   - RX pin
 *   - UART enable/status
 *   - 115200 baud
 *
 * DO NOT blindly flash this file until it matches your board.
 */

/ {
    aliases {
        /*
         * TODO: Replace this placeholder with your board's UART node.
         * Example: app-uart = &usart2;
         */
    };
};
