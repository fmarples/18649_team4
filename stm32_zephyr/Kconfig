mainmenu "Lab 2 integrated controller"
source "Kconfig.zephyr"

config LAB_TIMING_GPIO
    bool "CMD_RX and PWM_SET timing markers on PC2/PC3"
    default y
    help
      Reserve Morpho CN7 pins 35 and 37 for scope markers. No actuator wires
      belong on these pins. Disable only if the team reallocates these pins.

config LAB_CURRENT_SAMPLE_MS
    int "Current backend sampling period (ms)"
    default 20
    range 1 1000

config LAB_CURRENT_CHANNEL_MASK
    int "Connected current sensors: left=1, right=2, servo=4"
    default 5
    range 0 7
    help
      The current bench has left and servo sensors only (5). Use 7 when the
      third sensor is actually wired. Zero skips acquisition for A/B diagnosis;
      it does not change actuator policy. Missing inputs are unavailable.

config LAB_PERIODIC_DIAGNOSTICS
    bool "Periodic USB diagnostics (disable for a logging isolation test)"
    default y

config LAB_CURRENT_MAX_AGE_MS
    int "Maximum age of a valid current sample (ms)"
    default 100
    range 1 10000
    help
      Telemetry freshness policy, not a motor cutoff. Acquisition time counts
      toward age; stale or failed readings are unavailable in status frames.

menu "ACS712 5A calibration (direct ADC connection)"
comment "Defaults are vendor nominal values, not measured board calibration"

config LAB_CURRENT_LEFT_ZERO_MV
    int "Left zero-current sensor output (mV)"
    default 2500
    range 1 3299

config LAB_CURRENT_RIGHT_ZERO_MV
    int "Right zero-current sensor output (mV)"
    default 2500
    range 1 3299

config LAB_CURRENT_SERVO_ZERO_MV
    int "Servo zero-current sensor output (mV)"
    default 2500
    range 1 3299

config LAB_CURRENT_LEFT_SENSITIVITY
    int "Left sensitivity (mV/A)"
    default 185
    range 1 1000

config LAB_CURRENT_RIGHT_SENSITIVITY
    int "Right sensitivity (mV/A)"
    default 185
    range 1 1000

config LAB_CURRENT_SERVO_SENSITIVITY
    int "Servo sensitivity (mV/A)"
    default 185
    range 1 1000

endmenu
