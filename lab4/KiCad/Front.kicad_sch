 0) (unit 1) (in_bom yes) (on_board yes) (dnp no) (uuid "14abfbc5-cb14-4812-9ea9-2d05f3282685") (property "Reference" "J1" (at 518.16 114.3 0) (effects (font (size 1.1 1.1)))) (property "Value" "Sense test points" (at 518.16 118.11 0) (effects (font (size 1.1 1.1)))) (property "Footprint" "Connector_PinHeader_2.54mm:PinHeader_1x03_P2.54mm_Vertical" (at 518.16 124.46 0) (effects (font (size 1.1 1.1)) (hide yes))) (property "Datasheet" "" (at 518.16 124.46 0) (effects (font (size 1.1 1.1)) (hide yes))) (property "MPN" "" (at 518.16 124.46 0) (effects (font (size 1.1 1.1)) (hide yes))) (property "Design status" "" (at 518.16 124.46 0) (effects (font (size 1.1 1.1)) (hide yes))) (instances (project "Lab4" (path "/44398653-5654-4a4e-abec-378704809dbf/b2940267-5130-450b-8186-caee03d622fe" (reference "J1") (unit 1))))) (wire (pts (xy 500.38 121.92) (xy 496.57 121.92)) (stroke (width 0) (type default)) (uuid "4612009e-7487-45cf-967a-a5031ad248ff")) (label "SERVO_RAW" (at 496.57 121.92 0) (effects (font (size 1.0 1.0)) (justify right bottom)) (uuid "3b3c9ba5-46c3-4077-8d63-741e647f45d2")) (wire (pts (xy 500.38 124.46) (xy 496.57 124.46)) (stroke (width 0) (type default)) (uuid "64a6220e-12c4-4fb0-95af-cfe7de05be29")) (label "SERVO_ADC" (at 496.57 124.46 0) (effects (font (size 1.0 1.0)) (justify right bottom)) (uuid "1d517d4b-937f-44de-9831-44b7b022b461")) (wire (pts (xy 500.38 127.0) (xy 496.57 127.0)) (stroke (width 0) (type default)) (uuid "f0cbd894-b5ed-444e-aa73-9ef884f10fde")) (label "GND" (at 496.57 127.0 0) (effects (font (size 1.0 1.0)) (justify right bottom)) (uuid "d33c54e9-d1c0-4936-bfe0-5d1d929fd91e")) (text "6.6 V regulator -> 10 mOhm shunt -> servo +\nServo GND returns directly to power ground.\nKelvin sense: separate thin traces from shunt pads to IN+/IN-.\nGain 50: Vout = 0.5 V/A. Proposed range 0-5 A -> 0-2.5 V.\n12-bit / 3.3 V: 1.61 mA/count (ideal quantization).\nAt 5 A: shunt drop 50 mV; loss 0.25 W. Select >=1 W.\nRC: 4.7k + 100n -> 339 Hz; proposed ADC 4 ksample/s.\nNear-zero amplifier output clips; calibrate offset and gain.\nThis unidirectional circuit cannot measure regenerated current.\nNo servo idle/stall/noise measurements yet.\n5 A measurement range is NOT a 5 A driver or regulator rating." (at 350.52 165.1 0) (effects (font (size 1.5 1.5)) (justify left top)) (uuid "346aff35-a4d2-4fb2-9a70-bb689c697112")) (text "STM32F401RET6 - independent HSI/PLL, no ST-LINK clock dependency" (at 20.32 312.42 0) (effects (font (size 2.2 2.2)) (justify left top)) (uuid "55f90c7c-6ed2-4691-a881-542f4caf1705")) (symbol (lib_id "MCU_ST_STM32F4:STM32F401RETx") (at 100.33 402.59 0) (unit 1) (in_bom yes) (on_board yes) (dnp no) (uuid "2e1aaa30-4bf9-4453-a04a-c42e838d86cf") (property "Reference" "U50" (at 147.32 346.71 0) (effects (font (size 1.1 1.1)))) (property "Value" "STM32F401RET6TR" (at 147.32 350.52 0) (effects (font (size 1.1 1.1)))) (property "Footprint" "Package_QFP:LQFP-64_10x10mm_P0.5mm" (at 113.03 402.59 0) (effects (font (size 1.1 1.1)) (hide yes))) (property "Datasheet" "https://www.st.com/resource/en/datasheet/stm32f401re.pdf" (at 113.03 402.59 0) (effects (font (size 1.1 1.1)) (hide yes))) (property "MPN" "STM32F401RET6TR" (at 113.03 402.59 0) (effects (font (size 1.1 1.1)) (hide yes))) (property "Design status" "DS10086 LQFP64; pin 30 VCAP1 needs 4.7uF; no PB11; GPIO modes require PCB firmware port" (at 113.03 402.59 0) (effects (font (size 1.1 1.1)) (hide yes))) (instances (project "Lab4" (path "/44398653-5654-4a4e-abec-378704809dbf/b2940267-5130-450b-8186-caee03d622fe" (reference "U50") (unit 1))))) (wire (pts (xy 95.25 354.33) (xy 95.25 350.52)) (stroke (width 0) (type default)) (uuid "3221b50f-acac-467d-ba8b-78aee64dca8a")) (label "+3V3" (at 95.25 350.52 0) (effects (font (size 1.0 1.0)) (justify left bottom)) (uuid "01da0579-d6e6-4c05-9d8e-461be57166bf")) (wire (pts (xy 82.55 422.91) (xy 78.74 422.91)) (stroke (width 0) (type default)) (uuid "85560bb1-6804-4d0f-b403-d31f78c4dcae")) (label "F_SELFTEST_BUTT