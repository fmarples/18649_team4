stances (project "Lab4" (path "/44398653-5654-4a4e-abec-378704809dbf/b7be6aee-00c5-4ccf-bc13-a9abb8324aae" (reference "J3") (unit 1))))) (wire (pts (xy 514.35 217.17) (xy 510.54 217.17)) (stroke (width 0) (type default)) (uuid "0273f26d-3a6d-41c6-9c7c-4ff518a8142d")) (label "RIGHT_RAW" (at 510.54 217.17 0) (effects (font (size 1.0 1.0)) (justify right bottom)) (uuid "3a32caa3-941e-4300-bbed-c6f87f59e5db")) (wire (pts (xy 514.35 219.71) (xy 510.54 219.71)) (stroke (width 0) (type default)) (uuid "f40df919-1a9f-4012-bce4-c77f28459040")) (label "RIGHT_SCALED" (at 510.54 219.71 0) (effects (font (size 1.0 1.0)) (justify right bottom)) (uuid "cd10f347-b88e-4e33-b7df-c0e6ba2fe446")) (wire (pts (xy 514.35 222.25) (xy 510.54 222.25)) (stroke (width 0) (type default)) (uuid "73d12d6a-6376-4af5-97ce-ae096a971861")) (label "RIGHT_ADC" (at 510.54 222.25 0) (effects (font (size 1.0 1.0)) (justify right bottom)) (uuid "cf7ce6c4-77e0-4dee-b952-a8d0b9132483")) (wire (pts (xy 514.35 224.79) (xy 510.54 224.79)) (stroke (width 0) (type default)) (uuid "cd44c385-5c45-4501-99de-dcaa86540de5")) (label "GND" (at 510.54 224.79 0) (effects (font (size 1.0 1.0)) (justify right bottom)) (uuid "21fe0099-57c7-44e7-abd0-8351008b6a9c")) (text "Each motor: +/-5 A; VADC = 1.25 V + 0.0925 V/A * I.\nIdeal 12-bit scale: 8.71 mA/count at VREF=3.3 V.\n10k/10k divider keeps a 5 V sensor output at 2.5 V.\nFilter source resistance: (10k || 10k) + 1k = 6k.\n6k * 100n -> 265 Hz. Proposed ADC: 4 ksample/s/channel.\nStop motors before zero calibration; preserve signed readings.\nHall sensor has internal conductor, not an external shunt.\nAt 5 A and typical 1.2 mOhm, conductor loss = 30 mW.\nMotor return lead connects to the OTHER L298 output, not GND." (at 345.44 299.72 0) (effects (font (size 1.5 1.5)) (justify left top)) (uuid "54d2d075-bf52-4d2e-b586-4ef397389778")) (text "STM32F401RET6 - independent HSI/PLL, no ST-LINK clock dependency" (at 20.32 312.42 0) (effects (font (size 2.2 2.2)) (justify left top))