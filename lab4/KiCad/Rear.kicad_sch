293-892a-f1453c7bf89c")) (text "ENCODER INPUTS: board pins 1=5.1V, 2=GND, 3=A, 4=B. Verify actual cable order.\n10k pullups support open-collector outputs; push-pull input must stay <=5.5V.\nU81 at 3.3V gives Schmitt hysteresis and MCU-safe outputs; unused inputs grounded.\nBoth A and B invert. Check direction/counts after the PCB firmware port." (at 830 540 0) (effects (font (size 1.6 1.6)) (justify left top)) (uuid "4b3f1543-f135-4946-bcf4-c94108a05100")) (symbol (lib_id "Device:R") (at 25.4 795.02 0) (unit 1) (in_bom yes) (on_board yes) (dnp no) (uuid "4ef223ee-ac3f-44c7-80c2-6649171a206e") (property "Reference" "R650" (at 38.099999999999994 784.21 0) (effects (font (size 1.1 1.1)))) (property "Value" "2.2k" (at 38.099999999999994 787.21 0) (effects (font (size 1.1 1.1)))) (property "Footprint" "Resistor_SMD:R_0603_1608Metric" (at 38.099999999999994 795.02 0) (effects (font (size 1.1 1.1)) (hide yes))) (property "Datasheet" "https://www.digikey.com/en/products/detail/vishay-dale/CRCW06032K20FKEA/1174704" (at 38.099999999999994 795.02 0) (effects (font (size 1.1 1.1)) (hide yes))) (property "MPN" "CRCW06032K20FKEA" (at 38.099999999999994 795.02 0) (effects (font (size 1.1 1.1)) (hide yes))) (property "Design status" "Calculated circuit; not hardware validated" (at 38.099999999999994 795.02 0) (effects (font (size 1.1 1.1)) (hide yes))) (instances (project "Lab4" (path "/44398653-5654-4a4e-abec-378704809dbf/b7be6aee-00c5-4ccf-bc13-a9abb8324aae" (reference "R650") (unit 1))))) (wire (pts (xy 25.4 791.21) (xy 25.4 787.4)) (stroke (width 0) (type default)) (uuid "d68e12c3-e2fe-48b1-b165-2c9649016a7e")) (label "R_REAR_LEFT_LED" (at 25.4 787.4 0) (effects (font (size 1.0 1.0)) (justify left bottom)) (uuid "439d3dbb-d90d-4781-926f-c0a03beef7c3")) (wire (pts (xy 25.4 798.83) (xy 25.4 802.64)) (stroke (width 0) (type default)) (uuid "8a18eed8-31df-4f48-941b-6df489bcf54c")) (label "R_REAR_LEFT_LED_BASE" (at 25.4 802.64 0) (effects (font (size 1.0 1.0)) (justify left bottom)