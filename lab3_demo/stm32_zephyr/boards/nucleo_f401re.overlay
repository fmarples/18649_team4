/* Lab 3 Part 5 demo, shared by N2 and N3. Pin record: doc/LAB3_PINOUT.md.
 * CAN modules: SPI1 PA5/PA6/PA7 (XIAO D8 SCK, D9 MISO, D10 MOSI per the
 * handout erratum); module A CS PB6 / INT PA10, module B CS PC7 / INT PB5.
 * CONFIG_LAB3_SWAP_CAN_AB maps logical bus A to module B for a board whose
 * modules are wired to the opposite physical buses.
 */
#include <zephyr/dt-bindings/gpio/gpio.h>
#include <zephyr/dt-bindings/pwm/pwm.h>

/ {
    aliases { can-a = &can_a; can-b = &can_b; };
    zephyr,user {
        can-rx-a-gpios = <&gpioc 2 GPIO_ACTIVE_HIGH>;
        can-rx-b-gpios = <&gpioc 3 GPIO_ACTIVE_HIGH>;
        can-tx-a-gpios = <&gpioa 0 GPIO_ACTIVE_HIGH>;
        can-tx-b-gpios = <&gpioa 1 GPIO_ACTIVE_HIGH>;
        degraded-a-gpios = <&gpiob 0 GPIO_ACTIVE_HIGH>;
        degraded-b-gpios = <&gpiob 1 GPIO_ACTIVE_HIGH>;
        error-gpios = <&gpioc 0 GPIO_ACTIVE_HIGH>;
        /* STEER task-body marker; the SRV test point is the PB4 PWM below. */
        steer-task-gpios = <&gpioc 1 GPIO_ACTIVE_HIGH>;
        pwm-set-gpios = <&gpiob 9 GPIO_ACTIVE_HIGH>;
        dir-a-gpios = <&gpiob 10 GPIO_ACTIVE_HIGH>;
        /* PB11 does not exist on the LQFP64 package (pin 30 is VCAP1). */
        pid-gpios = <&gpioc 9 GPIO_ACTIVE_HIGH>;
        relay-tx-gpios = <&gpioc 6 GPIO_ACTIVE_HIGH>;
        front-left-gpios = <&gpioa 4 GPIO_ACTIVE_HIGH>;
        front-right-gpios = <&gpiob 8 GPIO_ACTIVE_HIGH>;
        rear-left-gpios = <&gpioc 4 GPIO_ACTIVE_HIGH>;
        rear-right-gpios = <&gpioc 5 GPIO_ACTIVE_HIGH>;
        test-button-gpios = <&gpioc 13 GPIO_ACTIVE_LOW>; /* built-in blue B1 */
        task-probe-gpios = <&gpioc 8 GPIO_ACTIVE_HIGH>;
        /* PB4/D5 TIM3_CH1: SRV servo pulse on N2, PWM_OUT motor PWM on N3.
         * Each zone passes its own period at run time. */
        pwms = <&pwm3 1 PWM_MSEC(20) PWM_POLARITY_NORMAL>;
    };
};

&spi1 {
    status = "okay";
    pinctrl-0 = <&spi1_sck_pa5 &spi1_miso_pa6 &spi1_mosi_pa7>;
    pinctrl-names = "default";
    cs-gpios = <&gpiob 6 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>,
               <&gpioc 7 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
    can_a: mcp2515@0 {
        compatible = "microchip,mcp2515";
        reg = <0>;
        spi-max-frequency = <10000000>; /* MCP2515 max; SPI1 runs 84 MHz/16 = 5.25 MHz */
        int-gpios = <&gpioa 10 GPIO_ACTIVE_LOW>;
        osc-freq = <16000000>;
        status = "okay";
    };
    can_b: mcp2515@1 {
        compatible = "microchip,mcp2515";
        reg = <1>;
        spi-max-frequency = <10000000>;
        int-gpios = <&gpiob 5 GPIO_ACTIVE_LOW>;
        osc-freq = <16000000>;
        status = "okay";
    };
};

/* 84 MHz / (83 + 1) = 1 us ticks: 20000 per servo period, 100 per 10 kHz motor period. */
&timers3 {
    status = "okay";
    st,prescaler = <83>;
    pwm3: pwm {
        status = "okay";
        pinctrl-0 = <&tim3_ch1_pb4>;
        pinctrl-names = "default";
    };
};

/* Board defaults that claim Lab 3 pins: USART1 PB6 (CAN A CS), I2C1 PB8/PB9
 * (FR LED, PWM_SET), I2C3 PA8/PC9 (PID marker), TIM2 PWM PA5 (SPI SCK). */
&usart1 { status = "disabled"; };
&i2c1 { status = "disabled"; };
&i2c3 { status = "disabled"; };
&timers2 { status = "disabled"; };

&iwdg { status = "okay"; };
